{
  "protocol_version": "1.0",
  "strategy_name": "stock_etf_correlation_gated_convergence",
  "status": "exploratory_post_selection_economic_backtest",
  "economic_results_inspected_before_protocol_freeze": false,
  "claim_boundary": [
    "The correlation models were selected on the same outer periods used here.",
    "Results are development evidence, not an untouched confirmatory test.",
    "The strategy uses quant-only forecasts; retrospective news features are excluded."
  ],
  "inputs": {
    "price_universe": "config/price_universe.json",
    "regular_bar_dir": "data/prices/alpaca/15min/sip/all",
    "calendar": "data/prices/alpaca/calendar/2016-01-01_2026-06-30.json",
    "predictions": "outputs/quant_training/v1/rung_03/predictions.parquet",
    "prediction_target": "t2_etf",
    "prediction_model": "xgboost"
  },
  "signal": {
    "divergence_lookback_sessions": 5,
    "beta_window_sessions": 252,
    "beta_minimum_sessions": 126,
    "beta_clip_lower": 0.0,
    "beta_clip_upper": 3.0,
    "predicted_correlation_floor": 0.5,
    "primary_variant": "ml_strengthening",
    "variants": [
      "unconditional",
      "historical_level",
      "ml_level",
      "ml_strengthening",
      "ml_weakening"
    ]
  },
  "portfolio": {
    "sector_neutral_stock_weights": true,
    "equal_active_sector_stock_gross": true,
    "minimum_eligible_names_per_sector": 2,
    "sleeve_combined_gross": 1.0,
    "holding_sessions": 5,
    "overlapping_sleeves": true,
    "daily_sleeve_fraction": 0.2
  },
  "execution": {
    "forecast_cutoff": "09:00 America/New_York",
    "entry": "official_regular_session_open",
    "exit": "official_regular_session_close",
    "overnight_exposure": false,
    "cost_bps_per_side": [0.0, 1.0, 2.0, 5.0],
    "primary_cost_bps_per_side": 2.0,
    "short_borrow_cost": "omitted_for_intraday_positions"
  },
  "inference": {
    "annualization_sessions": 252,
    "moving_block_sessions": 10,
    "bootstrap_resamples": 2000,
    "bootstrap_seed": 1729,
    "comparators": [
      "unconditional",
      "historical_level",
      "ml_level",
      "ml_weakening"
    ]
  },
  "outputs": {
    "directory": "outputs/stock_etf_spread/v1",
    "experiment_summary": "experiments/stock_etf_spread/v1/summary.json"
  }
}
