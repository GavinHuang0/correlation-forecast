# `models/` contains tracked public model cards and registries. Keep common
# binary checkpoint formats out if local artifacts are placed there.
models/**/*.bin
models/**/*.pt
models/**/*.pth
models/**/*.safetensors
models/**/*.onnx

# Per-fit experiment outputs are normally local. The compact selected
# RRES-C6 model card is explicitly retained as public evidence.
experiments/quant_deterministic_news/v3/training/models/
experiments/quant_deterministic_news/v4/training/models/*/
!experiments/quant_deterministic_news/v4/training/models/rres_coupling6_en/
!experiments/quant_deterministic_news/v4/training/models/rres_coupling6_en/**

